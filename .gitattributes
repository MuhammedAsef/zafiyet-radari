# Varsayılan: git satır sonlarını kendisi normalleştirir.
* text=auto

# Linux'ta çalışanlar her zaman LF: CRLF ile bash script'i ve nginx/compose dosyaları bozulur.
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf

# Windows araçları
*.ps1  text eol=crlf

*.woff2 binary
*.png   binary
