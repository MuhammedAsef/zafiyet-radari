<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- dotnet ef bu sınıf kütüphanesini startup projesi olarak çalıştırabilsin diye (scaffold). -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZafiyetRadari.Application\ZafiyetRadari.Application.csproj" />
    <ProjectReference Include="..\ZafiyetRadari.Domain\ZafiyetRadari.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Sadece scaffold için (dotnet ef). Çalışma zamanına ve diğer projelere taşınmaz. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Hangfire.NetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ayrıştırıcı (OSV, EPSS, KEV) testleri internal sınıflara erişir. -->
    <InternalsVisibleTo Include="ZafiyetRadari.UnitTests" />
  </ItemGroup>

</Project>
