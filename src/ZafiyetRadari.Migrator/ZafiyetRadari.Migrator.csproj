<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>zafiyet-radari-migrator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="Hangfire.SqlServer" />
  </ItemGroup>

  <!-- db/migrations altındaki script'ler isim sırasıyla uygulanır: 0000_, 0001_, ... -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
