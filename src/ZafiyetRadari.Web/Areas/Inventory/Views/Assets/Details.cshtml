@model AssetDetailsViewModel
@{
    var asset = Model.Asset;
    var components = Model.Components;
    ViewData["Title"] = asset.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Groups" asp-action="Index">Gruplar</a></li>
        <li class="breadcrumb-item"><a asp-controller="Groups" asp-action="Details" asp-route-id="@asset.AssetGroupId">@asset.AssetGroupName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@asset.Name</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div>
        <h1 class="h3 mb-2">@asset.Name</h1>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge text-bg-secondary">@InventoryLabels.Of(asset.Environment)</span>
            <span class="badge @InventoryLabels.CriticalityBadge(asset.Criticality)">Kritiklik: @InventoryLabels.Of(asset.Criticality)</span>
            @if (asset.IsInternetFacing)
            {
                <span class="badge text-bg-danger">İnternete açık</span>
            }
            <span class="badge text-bg-dark border">@asset.ActiveComponentCount aktif bileşen</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-sm btn-primary" asp-area="Findings" asp-controller="Findings" asp-action="Index" asp-route-assetId="@asset.Id">Bulgular</a>
    @if (Model.CanEdit)
    {
            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@asset.Id">Düzenle</a>
            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@asset.Id">Sil</a>
    }
    </div>
</div>

@if (Model.CanEdit)
{
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Dosya yükle</h2>
                    <p class="small text-secondary">
                        CycloneDX JSON SBOM, <code>package-lock.json</code> veya <code>packages.lock.json</code>.
                        En fazla @InventoryLimits.MaxUploadMegabytes MB. Biçim içerikten tanınır.
                    </p>
                    <form asp-action="Upload" asp-route-id="@asset.Id" method="post" enctype="multipart/form-data"
                          class="file-upload" data-file-upload data-max-bytes="@InventoryLimits.MaxUploadBytes">
                        @* Görünmez dosya girişi alanın tamamını kaplar: tıklama ve sürükle-bırak tarayıcının kendi davranışıyla çalışır. *@
                        <label class="file-drop" data-file-drop>
                            <input type="file" name="file" accept=".json,application/json" class="file-drop-input"
                                   required aria-label="Envanter dosyası" data-file-input />
                            <span class="file-drop-title" data-file-name>Dosya seç ya da buraya sürükle</span>
                            <span class="file-drop-meta" data-file-meta>.json · en fazla @InventoryLimits.MaxUploadMegabytes MB</span>
                        </label>
                        <div class="file-upload-footer">
                            <span class="file-upload-error" data-file-error role="alert"></span>
                            <button type="submit" class="btn btn-sm btn-primary text-nowrap" data-file-submit>Yükle</button>
                        </div>
                    </form>
                    @{ var lastUpload = asset.RecentUploads.FirstOrDefault(); }
                    @if (lastUpload is not null)
                    {
                        <p class="file-upload-last">
                            Son yükleme: <strong>@lastUpload.OriginalFileName</strong>
                            · @lastUpload.ComponentCount paket
                            · @lastUpload.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </p>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h6">Elle bileşen ekle</h2>
                    <form asp-action="AddComponent" asp-route-id="@asset.Id" method="post" class="row g-2" novalidate>
                        <div class="col-sm-3">
                            <select asp-for="NewComponent.Ecosystem" asp-items="InventoryLabels.EcosystemOptions()" class="form-select form-select-sm" aria-label="Ekosistem"></select>
                        </div>
                        <div class="col-sm-5">
                            <input asp-for="NewComponent.Name" class="form-control form-control-sm" placeholder="paket adı (ör. lodash)" aria-label="Paket adı" />
                        </div>
                        <div class="col-sm-2">
                            <input asp-for="NewComponent.Version" class="form-control form-control-sm" placeholder="4.17.21" aria-label="Sürüm" />
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100">Ekle</button>
                        </div>
                    </form>
                    <p class="small text-secondary mt-2 mb-0">Tam sürüm gir; <code>^1.2</code>, <code>latest</code> gibi aralıklar kabul edilmez.</p>
                </div>
            </div>
        </div>
    </div>
}

<section class="mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="h5 m-0">Bileşenler <span class="text-secondary small">(@components.TotalCount)</span></h2>
        <form asp-action="Details" asp-route-id="@asset.Id" method="get" class="d-flex gap-2 align-items-center">
            <input type="search" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Paket ara" maxlength="@ComponentFilter.MaxSearchLength" aria-label="Paket ara" />
            <div class="form-check text-nowrap m-0">
                <input type="checkbox" name="inactive" value="true" id="inactive" class="form-check-input" checked="@Model.IncludeInactive" />
                <label for="inactive" class="form-check-label small">Pasifler</label>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-secondary">Filtrele</button>
        </form>
    </div>

    @if (components.Items.Count == 0)
    {
        <p class="text-secondary">Gösterilecek bileşen yok.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>Ekosistem</th>
                        <th>Paket</th>
                        <th>Sürüm</th>
                        <th>Kaynak</th>
                        <th>Durum</th>
                        @if (Model.CanEdit)
                        {
                            <th class="text-end">İşlem</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var component in components.Items)
                    {
                        <tr class="@(component.IsActive ? "" : "text-secondary")">
                            <td><span class="badge text-bg-secondary">@component.Ecosystem</span></td>
                            <td><code>@component.Name</code></td>
                            <td><code>@component.Version</code></td>
                            <td class="small">@InventoryLabels.Of(component.Source)</td>
                            <td class="small">@(component.IsActive ? "Aktif" : "Pasif")</td>
                            @if (Model.CanEdit)
                            {
                                <td class="text-end">
                                    @if (component.IsActive)
                                    {
                                        <form asp-action="DeactivateComponent" asp-route-id="@asset.Id" method="post" class="m-0">
                                            <input type="hidden" name="componentId" value="@component.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Pasife al</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (components.TotalPages > 1)
        {
            <nav aria-label="Sayfalar">
                <ul class="pagination pagination-sm">
                    <li class="page-item @(components.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Details" asp-route-id="@asset.Id" asp-route-search="@Model.Search"
                           asp-route-inactive="@Model.IncludeInactive" asp-route-page="@(components.Page - 1)">Önceki</a>
                    </li>
                    <li class="page-item disabled"><span class="page-link">@components.Page / @components.TotalPages</span></li>
                    <li class="page-item @(components.Page >= components.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Details" asp-route-id="@asset.Id" asp-route-search="@Model.Search"
                           asp-route-inactive="@Model.IncludeInactive" asp-route-page="@(components.Page + 1)">Sonraki</a>
                    </li>
                </ul>
            </nav>
        }
    }
</section>

<section>
    <h2 class="h5 mb-2">Son yüklemeler</h2>
    @if (asset.RecentUploads.Count == 0)
    {
        <p class="text-secondary">Henüz dosya yüklenmedi.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Dosya</th>
                        <th>Biçim</th>
                        <th class="text-end">Paket</th>
                        <th class="text-end">Boyut</th>
                        <th>SHA-256</th>
                        <th>Tarih</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var upload in asset.RecentUploads)
                    {
                        <tr>
                            <td>@upload.OriginalFileName</td>
                            <td class="small">@InventoryLabels.Of(upload.Format)</td>
                            <td class="text-end">@upload.ComponentCount</td>
                            <td class="text-end small">@InventoryLabels.FileSize(upload.SizeBytes)</td>
                            <td><code class="small" title="@upload.Sha256Hex">@(upload.Sha256Hex[..12])…</code></td>
                            <td class="small text-secondary">@upload.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/file-upload.js" asp-append-version="true"></script>
}
