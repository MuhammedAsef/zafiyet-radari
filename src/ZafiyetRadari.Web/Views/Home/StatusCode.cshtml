@model int
@{
    ViewData["Title"] = Model.ToString();
    var message = Model switch
    {
        404 => "Aradığın sayfa bulunamadı.",
        403 => "Bu sayfaya erişim yetkin yok.",
        409 => "Kayıt sen işlem yaparken başka biri tarafından değiştirildi. Sayfayı yenileyip tekrar dene.",
        413 => "Gönderilen dosya çok büyük.",
        429 => "Çok fazla istek gönderdin. Biraz bekleyip tekrar dene.",
        _ => "İstek işlenemedi."
    };
}

<h1 class="h3">@Model</h1>
<p>@message</p>
<a asp-area="" asp-controller="Home" asp-action="Index">Genel bakışa dön</a>
