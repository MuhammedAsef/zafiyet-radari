@using ZafiyetRadari.Application.Abstractions.Identity
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var area = ViewContext.RouteData.Values["area"] as string ?? string.Empty;
    var controller = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;

    string Active(string linkArea, string? linkController = null) =>
        string.Equals(area, linkArea, StringComparison.OrdinalIgnoreCase)
        && (linkController is null || string.Equals(controller, linkController, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : string.Empty;

    string Current(string linkArea, string? linkController = null) => Active(linkArea, linkController) == "active" ? "page" : "false";

    var userName = User.Identity?.Name ?? string.Empty;
    var initial = userName.Length > 0 ? char.ToUpperInvariant(userName[0]).ToString() : "?";
}
<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] | Zafiyet Radarı</title>
    <link rel="preload" href="~/lib/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/fonts/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
</head>
<body>
    @* İkonlar: satır içi SVG sembolleri (ikon fontu veya CDN yok; CSP uyumlu). *@
    <svg xmlns="http://www.w3.org/2000/svg" class="d-none" aria-hidden="true">
        <symbol id="i-radar" viewBox="0 0 40 40">
            <circle cx="20" cy="20" r="18" fill="#081420" stroke="#34e0b4" stroke-width="1.5" />
            <circle cx="20" cy="20" r="11.5" fill="none" stroke="#34e0b4" stroke-opacity=".45" />
            <circle cx="20" cy="20" r="5" fill="none" stroke="#34e0b4" stroke-opacity=".45" />
            <path d="M20 20 L34 11" stroke="#34e0b4" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="27" cy="26" r="2.4" fill="#ff5a6a" />
        </symbol>
        <symbol id="i-overview" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4.5" /><path d="M12 12l6-4" />
        </symbol>
        <symbol id="i-assets" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="6" rx="1.5" /><rect x="3" y="14" width="18" height="6" rx="1.5" /><path d="M7 7h.01M7 17h.01" />
        </symbol>
        <symbol id="i-findings" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6l8-3z" /><path d="M12 8v5M12 16h.01" />
        </symbol>
        <symbol id="i-jobs" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
        </symbol>
        <symbol id="i-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 7h16M4 12h16M4 17h16" />
        </symbol>
    </svg>

    @if (signedIn)
    {
        <div class="app-shell">
            <aside class="sidebar offcanvas-lg offcanvas-start" id="sidebar" tabindex="-1" aria-label="Ana menü">
                <div class="offcanvas-body">
                    <div class="d-flex align-items-start justify-content-between">
                        <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <svg class="brand-mark" aria-hidden="true"><use href="#i-radar" /></svg>
                            <span class="brand-name">Zafiyet Radarı<small>Bağımlılık zafiyet takibi</small></span>
                        </a>
                        <button type="button" class="btn-close d-lg-none mt-4 me-3" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Menüyü kapat"></button>
                    </div>

                    <nav class="sidebar-nav" aria-label="Bölümler">
                        <a class="sidebar-link @Active("", "Home")" aria-current="@Current("", "Home")" asp-area="" asp-controller="Home" asp-action="Index">
                            <svg aria-hidden="true"><use href="#i-overview" /></svg>Genel bakış
                        </a>
                        <a class="sidebar-link @Active("Findings")" aria-current="@Current("Findings")" asp-area="Findings" asp-controller="Findings" asp-action="Index">
                            <svg aria-hidden="true"><use href="#i-findings" /></svg>Bulgular
                        </a>
                        <a class="sidebar-link @Active("Inventory")" aria-current="@Current("Inventory")" asp-area="Inventory" asp-controller="Groups" asp-action="Index">
                            <svg aria-hidden="true"><use href="#i-assets" /></svg>Varlıklar
                        </a>

                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <div class="sidebar-section">Yönetim</div>
                            <a class="sidebar-link" href="/ops/jobs">
                                <svg aria-hidden="true"><use href="#i-jobs" /></svg>Arka plan işleri
                            </a>
                        }
                    </nav>

                    <div class="sidebar-foot">
                        <a class="user-chip" asp-area="" asp-controller="Account" asp-action="Profile" title="Profil">
                            <span class="user-avatar" aria-hidden="true">@initial</span>
                            <span class="user-email">@userName</span>
                        </a>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn-signout">Çıkış yap</button>
                        </form>
                    </div>
                </div>
            </aside>

            <div class="app-main">
                <header class="topbar d-lg-none">
                    <button class="btn-menu" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Menüyü aç">
                        <svg aria-hidden="true"><use href="#i-menu" /></svg>
                    </button>
                    <span class="topbar-title">Zafiyet Radarı</span>
                </header>

                <main class="app-content" id="content">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="auth-shell">
            <aside class="auth-aside" aria-hidden="true">
                <div class="brand-row d-flex align-items-center gap-2">
                    <svg class="brand-mark"><use href="#i-radar" /></svg>
                    <span class="brand-name">Zafiyet Radarı</span>
                </div>
                <div>
                    <div class="scope"><span class="scope-sweep"></span><span class="blip blip-now"></span><span class="blip blip-week"></span><span class="blip blip-plan"></span></div>
                    <h2>Bağımlılıklarındaki zafiyetleri, sana ulaşmadan gör.</h2>
                    <p>npm ve NuGet paketlerini OSV, CISA KEV ve EPSS verileriyle eşleştirir; her bulguyu varlığının önemine göre önceliklendirir.</p>
                </div>
                <p class="small mb-0">Web Tabanlı Programlama dönem projesi</p>
            </aside>

            <main class="auth-main" id="content">
                <div class="auth-card">
                    <a class="brand-row d-lg-none" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg class="brand-mark" aria-hidden="true"><use href="#i-radar" /></svg>
                        <span class="brand-name">Zafiyet Radarı</span>
                    </a>
                    <partial name="_Alerts" />
                    @RenderBody()
                </div>
            </main>
        </div>
    }

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
