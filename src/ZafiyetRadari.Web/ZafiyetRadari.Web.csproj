<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>zafiyet-radari-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZafiyetRadari.Application\ZafiyetRadari.Application.csproj" />
    <ProjectReference Include="..\ZafiyetRadari.Infrastructure\ZafiyetRadari.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Hangfire.AspNetCore" />
  </ItemGroup>

  <!-- Hangfire paneli teması: derlemeye gömülür, wwwroot üzerinden servis edilmez. -->
  <ItemGroup>
    <None Remove="Ops\hangfire-theme.css;Ops\hangfire-theme.js" />
    <EmbeddedResource Include="Ops\hangfire-theme.css" LogicalName="ZafiyetRadari.Web.Ops.hangfire-theme.css" />
    <EmbeddedResource Include="Ops\hangfire-theme.js" LogicalName="ZafiyetRadari.Web.Ops.hangfire-theme.js" />
  </ItemGroup>

</Project>
