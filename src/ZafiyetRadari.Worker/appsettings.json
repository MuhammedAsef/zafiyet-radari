{
  "ConnectionStrings": {
    "Default": ""
  },
  "Ingestion": {
    "OsvBaseUrl": "https://osv-vulnerabilities.storage.googleapis.com",
    "KevUrl": "https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.json",
    "EpssUrl": "https://epss.empiricalsecurity.com/epss_scores-current.csv.gz",
    "MaxDownloadMegabytes": 2048,
    "BatchSize": 500,
    "IncludeMaliciousPackages": true,
    "MaxIncrementalRecords": 5000
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
